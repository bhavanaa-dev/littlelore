// backend/.env.example
# PostgreSQL connection string for development
# Replace the placeholders with your real credentials before running the app.
# Example format:
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name?schema=public

DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DB?schema=public

# Optional: change the port the Express server listens on (default 4000)
# PORT=4000
