# Frontend environment variables (Vercel: set these in the project dashboard)
#
# Local dev: leave unset (or leave this file as-is) — API calls use the
# relative path /api/books through the Vite dev proxy (see vite.config.js).
#
# Production: set to your deployed Render backend origin (no trailing slash),
# e.g. VITE_API_URL=https://littlelore-backend.onrender.com
# A value already ending in /api/books is also accepted.
VITE_API_URL=
